# HDD pools. Migration from md RAID1 to a 4-disk ZFS RAIDZ1 (`tank`), in progress:
#   1. [done] tank = RAIDZ1 of the 2 new disks (created once with `sudo tank-create`), data rsynced.
#   2. [now] Cutover: tank at /volume3, the md pool read-only at /volume3-old as a fallback.
#   3. After a week: wipe the md disks and `zpool attach tank raidz1-0 <disk>` each (RAIDZ expansion),
#      then `zfs rewrite -r` the data written before it (snapshots pin the old blocks, so prune them first).
#
# Old pool: ST4000VN006 WW6B7L3X + WW6B7KV1 (partition 2) -> mdadm RAID1 (UUID 73c2a38c:53e10d22:cc381e84:106cfb82)
#   -> LVM ug_A56BC9_1789909458_pool3/volume1 -> ext4 (UUID below), mounted read-only at /volume3-old.
# Created by UGOS; its proprietary ext4 feature `ugacl` was removed, so it is plain ext4 now.
{
  config,
  lib,
  pkgs,
  utils,
  flake-inputs,
  ...
}:
let
  # Whole disks by id. NEVER add the md disks (ST4000VN006) here before step 3.
  tankDisks = [
    "/dev/disk/by-id/ata-ST4000VN008-2DR166_ZDH4A67S"
    "/dev/disk/by-id/ata-ST4000VN008-2DR166_ZGY905ME"
  ];
  tankMountPoint = "/volume3";

  tankDevices = {
    disk = lib.listToAttrs (
      lib.imap1 (
        i: device:
        lib.nameValuePair "tank${toString i}" {
          type = "disk";
          inherit device;
          content = {
            type = "zfs";
            pool = "tank";
          };
        }
      ) tankDisks
    );
    zpool.tank = {
      type = "zpool";
      mode = "raidz1";
      options.ashift = "12";
      rootFsOptions = {
        compression = "lz4";
        atime = "off";
        xattr = "sa";
        acltype = "posixacl";
        mountpoint = "none";
        canmount = "off";
      };
      datasets.volume3 = {
        type = "zfs_fs";
        # legacy: mounted by fileSystems (generated by disko), not zfs-mount.service
        options = {
          mountpoint = "legacy";
          recordsize = "1M";
        };
        mountpoint = tankMountPoint;
        # The pool missing must not drop the box into emergency mode (remote access stays up)
        mountOptions = [ "nofail" ];
      };
    };
  };

  # disko's format script for tank only (never the system disk). It creates the pool and datasets
  # only if they don't exist yet; disks with any signature on them are skipped, hence the wipe prompt.
  tankFormat = (import "${flake-inputs.disko}/default.nix" { inherit lib; })._cliFormat {
    disko.devices = tankDevices;
  } pkgs;
  tankCreate = pkgs.writeShellApplication {
    name = "tank-create";
    runtimeInputs = [
      config.boot.zfs.package
      pkgs.util-linux
    ];
    text = ''
      if zpool list tank >/dev/null 2>&1; then
        echo "tank already exists"
        exit 0
      fi
      for disk in ${lib.escapeShellArgs tankDisks}; do
        if [ -n "$(wipefs --noheadings "$disk")" ]; then
          wipefs "$disk"
          read -r -p "Wipe these signatures from $disk? Type 'yes': " answer
          [ "$answer" = yes ] || exit 1
          wipefs --all "$disk"
        fi
      done
      ${lib.getExe' tankFormat "disko-format"}
      # disko imports with an altroot; re-import the regular way
      zpool export tank
      systemctl restart zfs-import-tank.service
      systemctl start ${lib.escapeShellArg "${utils.escapeSystemdPath tankMountPoint}.mount"}
      zpool status tank
      df -h ${tankMountPoint}
    '';
  };

  # ZED passes the message on stdin
  zedNotify = pkgs.writeShellScript "zed-notify" ''
    case "$1" in
      *scrub_finish*|*resilver_finish*|*trim_finish*) priority=default ;;
      *) priority=urgent ;;
    esac
    exec ${lib.getExe config.notify.package} -p "$priority" -t floppy_disk "$1" "$(cat)"
  '';
in
{
  # Assemble md arrays (incremental, via udev). Shows up as /dev/md127 (foreign homehost);
  # harmless since we mount by filesystem UUID.
  boot.swraid.enable = true;
  # LVM (services.lvm) is on by default and auto-activates the LV once md is assembled.

  # Fallback copy until step 3. nofail: a missing/degraded pool must not drop the box into
  # emergency mode (remote access stays up).
  fileSystems."/volume3-old" = {
    device = "/dev/disk/by-uuid/d955c9fb-98dd-453e-8db1-e3482c2fa455";
    fsType = "ext4";
    options = [
      "ro"
      "noatime"
      "nofail"
      "x-systemd.device-timeout=60s"
    ];
  };

  # Imported by zfs-import-tank.service (pool of a fileSystems entry); needs networking.hostId
  disko.devices = tankDevices;
  boot.supportedFilesystems.zfs = true;
  boot.zfs.forceImportRoot = false;
  # ARC defaults to nearly all RAM, which pushed the 16G box into swap. 8G leaves ~7.5G for services,
  # Immich ML and on-host nix builds (deploys); ARC still shrinks under memory pressure.
  boot.extraModprobeConfig = ''
    options zfs zfs_arc_max=${toString (8 * 1024 * 1024 * 1024)}
  '';
  environment.systemPackages = [ tankCreate ];

  services.zfs.autoScrub = {
    enable = true;
    interval = "Sun *-*-01..07 02:00";
  };
  services.zfs.zed.settings = {
    ZED_EMAIL_PROG = "${zedNotify}";
    ZED_EMAIL_OPTS = "'@SUBJECT@'";
    # Also report healthy scrub/resilver results
    ZED_NOTIFY_VERBOSE = true;
  };

  services.sanoid = {
    enable = true;
    datasets."tank/volume3" = {
      autosnap = true;
      autoprune = true;
      hourly = 24;
      daily = 30;
      monthly = 6;
    };
  };
}
